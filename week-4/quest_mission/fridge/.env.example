# Supabase 직접 호스트(db.<ref>.supabase.co)는 IPv6 전용 → IPv4 Session pooler 주소를 쓴다
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# AI 레시피 생성용 Claude API 키 — https://console.anthropic.com/settings/keys
# 없으면 AI 레시피 버튼만 막히고, 나머지 기능은 그대로 동작한다.
ANTHROPIC_API_KEY=sk-ant-여기에_발급받은_키

# (선택) 사용할 모델. 기본값 claude-opus-5
# ANTHROPIC_MODEL=claude-sonnet-5

# (선택) 포트. 기본값 3009
# PORT=3009
